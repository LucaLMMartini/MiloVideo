# Provider: openai | mock | gemini | claude_frames
PROVIDER=openai

# Required if PROVIDER=openai — used for all LLM / vision (image-recognition) calls.
OPENAI_API_KEY=
# Single unified model for every LLM/vision call (thesis: GPT-5, pinned snapshot).
OPENAI_MODEL=gpt-5
# Vision image detail level: low | high | auto
OPENAI_VISION_DETAIL=high
# Max frames per vision request (thesis: 10).
OPENAI_BATCH_SIZE=10

# Use the transcript IN the analysis (voiceover hints + transcript-derived facts).
# The transcript itself is ALWAYS created and translated regardless of this flag.
OPENAI_USE_AUDIO=true
# Transcription model (whisper-1 gives segment timestamps; needs ffmpeg on PATH).
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Target language the transcript is translated into for display (ISO-639-1 code).
TARGET_LANG=de

# Frame-sampling rate: sample points per second of video runtime (thesis: 1.0).
SAMPLE_FPS=1.0

# Only needed if PROVIDER=gemini
GOOGLE_API_KEY=

# Only needed if PROVIDER=claude_frames
ANTHROPIC_API_KEY=

# Optional: cap upload size in MB (default 4096)
MAX_UPLOAD_MB=4096
